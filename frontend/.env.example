# Server-only variables. Add these in Vercel Project Settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only elevated key used only by protected customer-order RPC calls.
# Never prefix with NEXT_PUBLIC_, expose it to a browser, or commit a real value.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Secret used to hash client IPs for anonymous order rate limiting.
# Generate at least 32 random bytes; never expose this value to the browser.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Public application URL used when generating table QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
