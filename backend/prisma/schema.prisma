generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id             String      @id
  customerName   String
  tableNumber    String?
  status         String
  paymentStatus  String
  paymentMethod  String?
  paymentAmount  Int?
  changeAmount   Int?
  paidAt         DateTime?
  voidedAt       DateTime?
  refundedAt     DateTime?
  voidReason     String?
  refundReason   String?
  paidById       String?
  total          Int
  createdAt      DateTime

  items          OrderItem[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())

  name      String
  qty       Int
  price     Int
  productId String?

  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id         String   @id @default(uuid())
  name       String   @unique
  price      Int
  category   String   @default("Menu")
  imageUrl   String?
  stock      Int?
  isActive   Boolean  @default(true)
  hasLevel   Boolean  @default(false)
  hasType    Boolean  @default(false)
  flavors    String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model Shift {
  id             String   @id
  cashierName    String

  openingCash    Int
  closingCash    Int?

  expectedCash   Int?
  actualCash     Int?

  difference     Int?

  status         String
  activeKey      String?  @unique

  notes          String?

  openedAt       DateTime
  closedAt       DateTime?
}
model AuditLog {
  id          String   @id

  action      String
  reason      String?

  orderId     String?

  cashierName String
  userId      String?
  metadata    Json?

  createdAt   DateTime
}
